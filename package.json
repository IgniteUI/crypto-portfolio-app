{
  "name": "cryptoapp",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng serve -o",
    "start:local": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng serve -o -c local",
    "build:old": "gulp overwrite-package-json && node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build --configuration production --optimization=false",
    "build": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build --configuration production",
    "build:gh-pages": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build --configuration production --base-href /crypto-portfolio-app/",
    "build:local": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build --configuration production-local",
    "build:web:old": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build && gulp build-site",
    "build:web:noProd": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build --output-path docs --base-href https://igniteui.github.io/crypto-portfolio-app/",
    "build:web:prod": "node --max_old_space_size=12192 node_modules/@angular/cli/bin/ng build --configuration production --output-path docs --base-href https://igniteui.github.io/crypto-portfolio-app/",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/fire": "21.0.0-rc.0",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@igniteui/angular-schematics": "^22.0.1551",
    "@igniteui/material-icons-extended": "^3.1.0",
    "@infragistics/igniteui-angular": "^22.1.0",
    "firebase": "^11.10.0",
    "igniteui-angular-charts": "^22.0.1",
    "igniteui-angular-core": "^22.0.1",
    "igniteui-angular-i18n": "^22.1.0",
    "minireset.css": "~0.0.4",
    "rxjs": "^7.8.1",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
